+        "unit": unit_slug,
+        "fixture": {
+            "path": str(fixture_path) if fixture_path else None,
+            "sha256": sha256_of(fixture_path),
+            "n_docs": len(fixture),
+            "n_assertions": sum(len(v or []) for v in fixture.values()),
+        },
+        "entities": {

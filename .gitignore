# ── Kandi CPT — version-control scope ──────────────────────────────
# COMMIT:  scripts/, logs/ (findings + evals), corpus/, corpus_synthetic/,
#          probes/, requirements.txt, docs.
# IGNORE:  virtualenv, trained checkpoints, regenerable tokenized shards,
#          the scrape landing zone, large binaries, secrets, caches.

# Python environment
.venv/
__pycache__/
*.pyc
*.pyo
*.egg-info/

# Trained checkpoints (~15 GB, local-only — regenerated by train scripts)
checkpoints/

# Tokenized shards (regenerable from corpus via scripts/tokenize_corpus.py)
tokenized/

# Scrape landing zone (created by the ingestion pipeline — raw, unfiltered)
raw/

# Large binaries — never commit weights, audio, video, tokenized blobs
*.arrow
*.bin
*.safetensors
*.pt
*.pth
*.gguf
*.litertlm
*.tflite
*.npz
# audio/video pulled for Whisper transcription
*.mp3
*.wav
*.m4a
*.webm
*.mp4
*.opus
*.flac

# Secrets / credentials
.env
.env.*
*.key
credentials.json
secrets.json

# pip-redirect junk ("=X.Y.Z" files from unquoted version specifiers)
=*

# OS / editor
.DS_Store
*.swp

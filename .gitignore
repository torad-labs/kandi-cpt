# ── Kandi CPT — version-control scope ──────────────────────────────
# COMMIT:  scripts/, logs/, configs/, manifests/, docs/, requirements.txt,
#          data/<festival>/<city>/<year>/ (10_clean source, 15_structured,
#          20_synthetic while small, holdout) and data/_shared/.
# IGNORE:  virtualenv, trained checkpoints, regenerable tokenized shards,
#          the per-edition scrape landing zones, large binaries, secrets, caches.

# Python environment
.venv/
__pycache__/
*.pyc
*.pyo
*.egg-info/

# Rust / Node build + dependency dirs (regenerable; lockfiles Cargo.lock / package-lock.json ARE committed)
target/
node_modules/

# Trained checkpoints (~15 GB, local-only — regenerated by train scripts)
checkpoints/

# Tokenized/packed shards — cross-edition trainer-ready build artifact,
# regenerable from per-edition clean+synthetic via scripts/tokenize_corpus.py
data/_build/30_tokenized/

# Derived/debug build artifacts (regenerable): geometry-probe viz + structured-extraction reject logs.
# (data/_build/curation/ IS committed — keep_list.json is the tokenizer's source-of-truth.)
data/_build/geometry/
data/_build/structured_rejects/

# Transient run logs (training/sweep/synth stdout). Progress docs (logs/*.md) ARE committed.
logs/*.log

# Scrape landing zones — raw web downloads, one per edition (regenerable by re-scrape)
data/**/00_raw/

# NOTE: per-edition data/<festival>/<city>/<year>/20_synthetic/ (derived expansion)
# is COMMITTED while small (~MBs; costly to regenerate via teacher API). When the
# fact-density rebuild grows it large, ignore it here (data/**/20_synthetic/) and
# move to external/object storage instead.

# Large binaries — never commit weights, audio, video, tokenized blobs
*.arrow
*.bin
*.safetensors
*.pt
*.pth
*.gguf
*.litertlm
*.tflite
*.npz
# audio/video pulled for Whisper transcription
*.mp3
*.wav
*.m4a
*.webm
*.mp4
*.opus
*.flac

# Secrets / credentials
.env
.env.*
*.key
credentials.json
secrets.json

# pip-redirect junk ("=X.Y.Z" files from unquoted version specifiers)
=*

# OS / editor
.DS_Store
*.swp

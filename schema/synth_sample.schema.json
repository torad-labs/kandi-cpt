{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kandi-cpt/schema/synth_sample.schema.json",
  "title": "Synthetic sample",
  "description": "Substrate spec §7.1 (record type synth_sample) + §10. A generated training surface derived from structured records. Eight shapes (§10.1), audience variants (§10.2), and per-primitive span tags for reasoning chains (§10.4). The metadata envelope carries synthesis_lineage, quality_score, etc.",
  "type": "object",
  "required": ["id", "shape", "content", "source_record_ids", "metadata"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string" },
    "shape": {
      "enum": ["entity_relation_passage", "qa_pair_set", "knowledge_list", "encyclopedic_third_person", "friend_chat_dialog", "wayfinding_first_person", "reasoning_chain", "cross_document_synthesis"],
      "description": "§10.1 8-shape catalog (distinct from synthesis_lineage.generation_strategy)"
    },
    "audience_variant": {
      "enum": ["first-timer", "veteran", "parent_with_kid", "solo_budget", "accessibility_user", "international_traveler", "crew_lead"],
      "description": "§10.2"
    },
    "content": { "type": "string", "minLength": 1 },
    "source_record_ids": { "type": "array", "items": { "type": "string" }, "description": "entity/triple/discourse ids this surface derives from" },
    "span_tags": {
      "type": "array",
      "description": "§10.4 — for reasoning_chain: which navigation primitive fires on which token span (becomes the QGRE reward signal, §6.3)",
      "items": {
        "type": "object",
        "required": ["primitive", "start", "end"],
        "additionalProperties": false,
        "properties": {
          "primitive": { "type": "string" },
          "start": { "type": "integer", "minimum": 0 },
          "end": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "metadata": { "$ref": "metadata.schema.json" }
  }
}
